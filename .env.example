# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dotbest"

# App
APP_BASE_URL="https://your-domain.com"
DEFAULT_TIMEZONE="Asia/Tehran"

# Telegram
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="yourbotname"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"

# Bale
BALE_BOT_TOKEN="your-bale-token"
BALE_BOT_USERNAME="your-bale-username"
BALE_WEBHOOK_URL="https://your-domain.com/api/bale/webhook"
BALE_WEBHOOK_SECRET="your-bale-webhook-secret"

# Payment
PAYMENT_PROVIDER_BASE_URL="https://api.zarinpal.com"
PAYMENT_PROVIDER_MERCHANT_ID="your-merchant-id"
PAYMENT_PROVIDER_SECRET=""
PAYMENT_PROVIDER_CALLBACK_URL="https://your-domain.com/api/payments/callback"
PAYMENT_REQUEST_TIMEOUT_MINUTES="30"
# Fallback کارمزد درگاه (درصد) — فقط اگر API زرین‌پال feeCalculation در دسترس نباشد
# در حالت عادی سیستم از API زرین‌پال کارمزد واقعی را می‌گیرد
PAYMENT_GATEWAY_FEE_PERCENT="0"

# Jobs
CRON_REMINDER_SECRET="your-cron-secret"

# Admin
ADMIN_SECRET="your-admin-secret"

# Booking
BOOKING_SLOT_INTERVAL_MINUTES="30"
